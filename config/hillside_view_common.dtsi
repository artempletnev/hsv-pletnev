#include <behaviors/studio_unlock.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0
#define NUM 1
#define SYM 2
#define FUN 3
#define ADJ 4

#define QUICK_TAP_MS 175
#define TAPPING_TERM_MS 150

&sk {
    release-after-ms = <600>;
    quick-release;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        // SYM + FUN = ADJ
        tri_layer {
            if-layers = <SYM FUN>;
            then-layer = <ADJ>;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps {
            timeout-ms = <50>;
            key-positions = <17 18>;  // G and H (home row shifts)
            bindings = <&caps_word>;
        };
    };

    behaviors {
        lq: layer_toggle_quick {
            compatible = "zmk,behavior-hold-tap";
            label = "Layer Toggle Quick";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&mo>, <&kp>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold Tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        htb: hold_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold Tap Balanced";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ============================================
        // Слой 0: DEF — основной (буквы + модификаторы)
        // ============================================
        default_layer {
            display-name = "Default";
            bindings = <
    &kp ESC        &ht NUM Q     &kp W      &kp E      &kp R       &kp T         &kp Y    &kp U        &kp I       &kp O        &ht SYM P     &kp LBKT
    &kp AMPS       &ht FUN A     &kp S      &kp D      &kp F       &kp G         &kp H    &kp J        &kp K       &kp L        &ht FUN SEMI  &ht SYM SQT
    &kp GRAVE      &ht FUN Z     &kp X      &kp C      &kp V       &kp B         &kp N    &kp M        &kp RBKT    &kp FSLH     &ht NUM DOT   &kp COMMA
                                                          &kp END                            &kp C_PP
                            &ht LCTRL TAB &ht LSHFT SPC &ht LGUI DEL &lq FUN F23     &lq ADJ F24 &ht RGUI BSPC &ht RSHFT RET &lq ADJ APP
            >;

            // Энкодеры: левый = Page Up/Down, правый = стрелки
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp LEFT RIGHT>;
        };

        // ============================================
        // Слой 1: NUM — Нампад (цифры + математика)
        // ============================================
        num_layer {
            display-name = "NumPad";
            bindings = <
    &trans   &kp KP_PLUS &kp KP_MINUS &trans &trans &trans      &trans   &kp N7      &kp N8   &kp N9    &kp KP_PLUS &trans
    &trans   &kp KP_MULTIPLY &kp KP_DIVIDE &trans &trans &trans  &trans   &kp N4      &kp N5   &kp N6    &kp KP_MINUS &trans
    &trans   &trans &trans &trans &trans &trans                  &trans   &kp N1      &kp N2   &kp N3    &kp KP_ENTER &trans
                                                          &trans                &trans
                         &trans &trans &trans &trans                 &trans    &kp N0  &kp DOT  &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp LEFT RIGHT>;
        };

        // ============================================
        // Слой 2: SYM — Символы + F13-F24
        // ============================================
        sym_layer {
            display-name = "Symbols";
            bindings = <
    &kp CIRC   &kp TILDE &kp HASH &kp PRCNT &kp LPAR &kp RPAR            &kp COMMA &kp LBKT        &kp RBKT      &trans       &trans       &trans
    &kp DLLR   &kp AT    &kp UNDER &kp EQUAL &kp MINUS &kp DQT            &kp SQT   &kp LBRC        &kp RBRC      &kp AMPS     &trans       &trans
    &kp QUES   &kp EXCL  &kp BSLH &kp SEMI &kp COLON &kp ASTR            &kp DOT   &kp LT          &kp GT        &trans       &trans       &trans
                                                          &trans                            &trans
                                &trans &trans &trans &trans                    &trans     &trans        &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp F15 F14 &inc_dec_kp C_NEXT C_PREV>;
        };

        // ============================================
        // Слой 3: FUN — F1-F12 + медиа + навигация
        // ============================================
        fun_layer {
            display-name = "Functions";
            bindings = <
    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6             &kp F7    &kp F8    &kp F9    &kp F10    &kp F11   &kp F12
    &trans    &trans    &trans    &trans    &trans    &trans             &kp HOME  &kp PG_DN &kp PG_UP &kp END    &kp DEL   &kp BSPC
    &trans    &trans    &trans    &trans    &trans    &trans             &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE
                                                          &trans                            &trans
                         &trans &trans &trans &trans                          &trans     &trans       &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp F15 F14 &inc_dec_kp C_NEXT C_PREV>;
        };

        // ============================================
        // Слой 4: MOUSE — Мышь + навигация
        // ============================================
        mouse_layer {
            display-name = "Mouse";
            bindings = <
    &trans   &trans   &trans   &trans   &trans   &trans             &trans     &trans     &trans     &trans     &trans   &trans
    &trans   &trans   &trans   &trans   &trans   &trans             &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans   &trans
    &trans   &trans   &trans   &trans   &trans   &trans             &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &trans   &trans
                                                          &trans                            &trans
                         &trans &trans &trans &trans                    &trans     &trans       &trans      &trans
            >;

            // Левый энкодер = скролл мыши, правый = стрелки
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp LEFT RIGHT>;
        };

        // ============================================
        // Слой 5: ADJ — RGB, BT, системные
        // ============================================
        adj_layer {
            display-name = "Adjust";
            bindings = <
    &bootloader   &rgb_ug TOG   &rgb_ug EFF   &rgb_ug EFR   &rgb_ug EFS   &trans             &out OUT_TOG   &trans   &trans     &trans     &trans     &bootloader
    &sys_reset    &rgb_ug HUI   &rgb_ug HUD   &rgb_ug BRI   &rgb_ug BRD   &trans             &studio_unlock &trans   &trans     &trans     &trans     &sys_reset
    &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4        &kp C_PREV     &kp C_PP &kp C_NEXT &kp C_VOL_UP &kp C_VOL_DN &trans
                                                          &trans                            &trans
                         &ext_power EP_TOG &trans &trans &trans                &trans     &trans       &trans      &trans
            >;

            // F15 и F14 — яркость дисплея macOS
            sensor-bindings = <&inc_dec_kp F15 F14 &inc_dec_kp PG_UP PG_DN>;
        };
    };
};