#include <behaviors/studio_unlock.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0     /* Индекс слоя Default (базовый) */
#define SYM 1     /* Индекс слоя Symbols (символы) */
#define NUM 2     /* Индекс слоя Numbers (цифры + F1-F10) */
#define ADJ 3     /* Индекс слоя Adjust (настройки, BT, bootloader) */
#define QUICK_TAP_MS 175   /* Порог (мс) для «быстрого» двойного тапа в hold-tap */
#define TAPPING_TERM_MS 150 /* Макс. время (мс) удержания, после которого считается hold, а не tap */

&sk {                           /* Глобальная настройка Sticky Key (липкая клавиша) */
    release-after-ms = <600>;   /* Липкая клавиша автоматически отпускается через 600 мс */
    quick-release;              /* Если нажата любая другая клавиша — липкая отпускается сразу */
};

/ {                                                     /* Корневой узел device tree */
    conditional_layers {                                /* Условные слои: автоактивация слоёв */
        compatible = "zmk,conditional-layers";

        tri_layer {                                     /* Правило: если SYM или NUM → включить ADJ */
            if-layers = <SYM NUM>;                      /* Если активен слой 1 (SYM) или 2 (NUM) */
            then-layer = <ADJ>;                         /* То также активировать слой 3 (ADJ) */
        };                                              /* ADJ «накладывается» поверх SYM/NUM */
    };

    combos {                                            /* Комбо: одновременное нажатие = действие */
        compatible = "zmk,combos";

        caps {
            timeout-ms = <50>;                          /* Клавиши комбо нужно нажать в течение 50 мс */
            key-positions = <17 18>;                    /* Позиции клавиш #17 и #18 (G и H) */
            bindings = <&caps_word>;                    /* Действие: Caps Word (авто-Caps на слово) */
        };
    };

    behaviors {                                         /* Пользовательские поведения */
        lq: layer_toggle_quick {                        /* lq — алиас для быстрой смены слоя */
            compatible = "zmk,behavior-hold-tap";       /* Тип: hold-tap (разное действие при tap/hold) */
            label = "Layer Toggle Quick";               /* Имя в отладке/Studio */
            #binding-cells = <2>;                       /* Принимает 2 параметра: <hold_action tap_action> */
            flavor = "tap-preferred";                   /* При неоднозначности — считаем tap */
            tapping-term-ms = <TAPPING_TERM_MS>;        /* 150 мс на решение tap vs hold */
            quick-tap-ms = <QUICK_TAP_MS>;              /* 175 мс для быстрого двойного тапа */
            bindings = <&mo>, <&kp>;                    /* hold = &mo (моментарный слой), tap = &kp (нажатие) */
        };

        ht: hold_tap {                                  /* ht — стандартный hold-tap */
            compatible = "zmk,behavior-hold-tap";
            label = "Hold Tap";
            #binding-cells = <2>;                       /* 2 параметра: <hold_key tap_key> */
            flavor = "tap-preferred";                   /* Приоритет tap */
            tapping-term-ms = <200>;                    /* 200 мс на решение */
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;                    /* hold = ключ, tap = ключ (оба Key Press) */
        };

        htb: hold_tap_balanced {                        /* htb — сбалансированный hold-tap */
            compatible = "zmk,behavior-hold-tap";
            label = "Hold Tap Balanced";
            #binding-cells = <2>;
            flavor = "balanced";                        /* Равный баланс tap/hold (не偏向 ни к чему) */
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
    &kp ESC        &kp Q        &kp W        &kp E        &kp R           &kp T           &kp Y       &kp U           &kp I        &kp O        &kp P        &kp LBKT
    &kp AMPS       &kp A        &kp S        &kp D        &kp F           &kp G           &kp H       &kp J           &kp K        &kp L        &kp SEMI     &kp SQT
    &kp GRAVE      &kp Z        &kp X        &kp C        &kp V           &kp B           &kp N       &kp M           &kp RBKT     &kp FSLH     &kp DOT      &kp COMMA 
                                                           &kp END                                                      &kp C_PP
                                 &ht LCTRL TAB &ht LSHFT SPACE &ht LGUI DEL &lq SYM G+SPACE      &lq NUM F24 &ht RALT BSPC &ht RSHFT RET &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp  LEFT RIGHT>;
        };


        sym_layer {
            display-name = "Symbols";
            bindings = <
    &trans   &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT       &kp CARET   &kp AMPS   &kp KP_MULTIPLY    &kp LPAR   &kp RPAR   &kp BSPC
    &trans   &trans     &trans     &trans     &trans     &trans          &kp MINUS   &kp EQUAL  &kp LBKT           &kp RBKT   &kp BSLH   &kp GRAVE
    &trans   &trans     &trans     &trans     &trans     &trans          &kp UNDER   &kp PLUS   &kp LBRC           &kp RBRC   &kp PIPE   &kp TILDE
                                                         &kp END         &kp C_PP
                        &trans     &trans     &trans     &trans          &trans     &trans             &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp C_NEXT C_PREV>;
        };

        num_layer {
            display-name = "Numbers";
            bindings = <
                &trans   &trans    &trans    &trans     &trans              &trans              &kp DOT   &kp N7      &kp N8   &kp N9    &kp KP_PLUS &trans
                &trans   &trans    &trans    &trans     &kp KP_PLUS         &kp KP_MINUS        &kp N0   &kp N4      &kp N5   &kp N6    &kp KP_MINUS &trans
                &trans   &trans    &trans    &trans     &kp KP_MULTIPLY     &kp KP_DIVIDE       &trans   &kp N1      &kp N2   &kp N3    &kp KP_ENTER &trans
                                                                            &trans              &trans
                                      &trans       &trans       &trans      &trans              &trans     &trans     &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp HOME END &inc_dec_kp C_NEXT C_PREV>;
        };

        adj_layer {
            display-name = "Adjust";
            bindings = <
                &bootloader   &rgb_ug TOG   &rgb_ug EFF   &rgb_ug EFR   &rgb_ug EFS   &trans             &out OUT_TOG    &trans            &trans     &trans     &trans     &bootloader
                &sys_reset    &rgb_ug HUI   &rgb_ug HUD   &rgb_ug BRI   &rgb_ug BRD   &trans             &kp PRINTSCREEN &studio_unlock    &trans     &trans     &trans     &sys_reset
                &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4       &kp C_PREV      &kp C_PP          &kp C_NEXT &kp C_VOL_UP &kp C_VOL_DN &trans
                                                                 &trans                                  &trans
                                  &ext_power EP_TOG &trans      &trans         &trans                    &trans   &trans     &trans         &trans
            >;

            // F15 and F14 are brightness controls for macOS
            sensor-bindings = <&inc_dec_kp F15 F14 &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
